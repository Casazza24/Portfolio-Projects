# Copy to .env and fill in. .env is gitignored; this file is not.
# Anything set in the real environment wins over what is in .env.

# --- Postgres (local Olist source) -------------------------------------------
# These are the docker-compose.yml defaults, so the extract half runs on a fresh
# clone without a .env at all. Override only if you moved Postgres.
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail
PGUSER=retail
PGPASSWORD=retail

# --- Snowflake ---------------------------------------------------------------
# No defaults for the first three -- warehouse/load_snowflake.py refuses to run
# without them rather than guessing.
# SNOWFLAKE_ACCOUNT is the account identifier, e.g. abcd-xy12345 (not the URL).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Must match warehouse/raw_schema.sql, which creates all of these.
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_DATABASE=RETAIL_PLATFORM
SNOWFLAKE_SCHEMA=RAW
