# Copy to airflow/.env. Read by docker compose, not by the DAG directly.
# Both values have working defaults, so `docker compose up -d` runs without it.

# Shared secret between the Airflow containers and airflow/host_runner.py.
# Not a real credential -- the runner only exposes a fixed list of jobs, so the
# worst a leaked token buys is the ability to trigger the same pipeline the UI
# already triggers. Change it anyway if this ever runs on a shared network.
HOST_RUNNER_TOKEN=local-dev

# UID the Airflow containers run as. The image's default is 50000; set this to
# your own `id -u` on Linux if the bind-mounted logs/ ends up root-owned.
AIRFLOW_UID=50000