# Copy to dbt/.env and fill in once the Snowflake trial exists. Gitignored.
#   set -a && source dbt/.env && set +a

# Account identifier, NOT the login URL. Snowsight shows it under
# Admin -> Accounts as <ORG>-<ACCOUNT>, e.g. abcdefg-xy12345.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# A trial account starts as ACCOUNTADMIN, which is a bad habit to build on.
# Create a dedicated role that owns the database and grant it the warehouse.
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_DATABASE=RETAIL_PLATFORM

# dbt writes into <SNOWFLAKE_SCHEMA>_staging and <SNOWFLAKE_SCHEMA>_marts
# (dbt concatenates the custom schema onto this one by default). Point a second
# developer at a different value here and they get their own copy of the
# warehouse without touching yours.
SNOWFLAKE_SCHEMA=DBT_DEV

# Schema the loaders land raw data in. Referenced by models/staging/_sources.yml.
SNOWFLAKE_RAW_SCHEMA=RAW
